#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);


    int n;cin>>n;
    vector<int>arr(n);
    for (int i = 0; i < n; ++i){
        cin>>arr[i];
    }

    vector<int>ans(n,-1);
    stack<int>st;

    for (int i = n - 1; i >= 0; --i){
        while(!st.empty() && arr[st.top()] <= arr[i]){
            st.pop();
        }
        if(!st.empty()){
            ans[i] = arr[st.top()];
        }
        st.push(i);
    }

    for (int it : ans){
        cout<<it<<" ";
    }

    return 0;
}
